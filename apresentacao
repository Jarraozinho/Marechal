import cv2
import mediapipe as mp
import pyautogui
import time
import os

# Caminho da sua apresentação PowerPoint
CAMINHO_APRESENTACAO = r"C:\Users\Marcos\OneDrive\Área de Trabalho\modelo sample.pptm"

# Abre a apresentação automaticamente
print("Abrindo a apresentação...")
os.startfile(CAMINHO_APRESENTACAO)
time.sleep(5)  # Espera o PowerPoint abrir

# Inicializa MediaPipe
mp_hands = mp.solutions.hands
mp_drawing = mp.solutions.drawing_utils
hands = mp_hands.Hands(max_num_hands=1)

# Função para detectar o gesto
def detectar_gesto(landmarks):
    dedos = []

    # Polegar
    if landmarks[4].x < landmarks[3].x:
        dedos.append(1)
    else:
        dedos.append(0)

    # Outros dedos (índice ao mínimo)
    for i in [8, 12, 16, 20]:
        if landmarks[i].y < landmarks[i - 2].y:
            dedos.append(1)
        else:
            dedos.append(0)

    if dedos == [1, 0, 0, 0, 0]:
        return "joinha"
    elif sum(dedos) == 0:
        return "punho"
    elif dedos == [0, 1, 1, 0, 0]:
        return "paz"
    else:
        return "nada"

# Variáveis de controle de repetição
ultimo_gesto = None
tempo_ultimo = time.time()

# Executa ação com base no gesto
def acionar_comando(gesto):
    global ultimo_gesto, tempo_ultimo
    tempo_atual = time.time()

    if gesto != ultimo_gesto or (tempo_atual - tempo_ultimo > 2):
        if gesto == "joinha":
            pyautogui.press("right")
            print("➡️ Próximo slide")
        elif gesto == "punho":
            pyautogui.press("left")
            print("⬅️ Slide anterior")
        elif gesto == "paz":
            pyautogui.press("esc")
            print("🛑 Saindo da apresentação")

        ultimo_gesto = gesto
        tempo_ultimo = tempo_atual

# Webcam
cap = cv2.VideoCapture(0)
print("Controle de apresentação iniciado. Pressione ESC para sair.")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    resultado = hands.process(rgb)

    if resultado.multi_hand_landmarks:
        for mao in resultado.multi_hand_landmarks:
            mp_drawing.draw_landmarks(frame, mao, mp_hands.HAND_CONNECTIONS)
            gesto = detectar_gesto(mao.landmark)
            if gesto != "nada":
                cv2.putText(frame, f"Gesto: {gesto}", (10, 70), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 255, 0), 3)
                acionar_comando(gesto)

    cv2.imshow("Controle por Gestos - IA", frame)

    if cv2.waitKey(1) & 0xFF == 27:  # ESC
        break

cap.release()
cv2.destroyAllWindows()
